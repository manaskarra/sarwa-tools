{
  "name": "sarwa-cli",
  "version": "1.1.0",
  "description": "Unofficial read-only, agent-ready portfolio CLI for Sarwa Odyssey.",
  "type": "module",
  "bin": {
    "sarwa": "bin/sarwa.js",
    "sarwa-mcp": "bin/sarwa-mcp.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./mcp": "./src/mcp.js"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check bin/sarwa.js && node --check bin/sarwa-mcp.js && node --check src/*.js",
    "test": "node --test",
    "verify": "npm run check && npm test",
    "prepack": "npm run verify"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "commander": "15.0.0",
    "playwright-core": "1.62.0",
    "zod": "4.4.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manaskarra/sarwa-cli.git"
  },
  "homepage": "https://github.com/manaskarra/sarwa-cli#readme",
  "bugs": {
    "url": "https://github.com/manaskarra/sarwa-cli/issues"
  },
  "keywords": [
    "sarwa",
    "portfolio",
    "cli",
    "uae",
    "investing"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
